<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gameRootFrame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!-- Native OpenGL / SAMP Surface Container -->
    <SurfaceView
        android:id="@+id/gameSurfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top-Right Connection Watermark & Diagnostics Overlay -->
    <LinearLayout
        android:id="@+id/hudOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="14dp"
        android:background="@drawable/bg_glass_card"
        android:padding="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvHudServerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MEGA LIFE ROLEPLAY"
            android:textColor="@color/brand_blue_glow"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHudConnectionInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connecting to mega-life.top:7777..."
            android:textColor="@color/text_white"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
